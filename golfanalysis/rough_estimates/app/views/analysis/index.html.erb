      <span class="sub">Every shot of every session, same scales throughout.</span>
      ${mult?`<a class="btn act" href="${href('total')}">Trend &amp; confidence ↓</a>`:''}
    </div>
    <div class="panel">
      ${mult?`${mult.html}
        <p class="caption">0–${mult.sc.xmax} yd downrange, ±${mult.sc.ymax} yd offline, shared across all
        ${mult.sess.length} panels. Ring = the 68% ellipse; a tilted ring means your longer shots also miss to one
        side. Scan the row rather than overlaying — past about eight sessions, stacked ovals stop separating.</p>`
       :`<p class="empty"><svg width="66" height="55" viewBox="0 0 48 40" aria-hidden="true" style="margin:0 auto 10px"><g fill="var(--brand)"><path d="M1.2 36.0C1.0 32.4 -0.3 30.4 0.9 28.1C2.0 30.4 3.4 32.4 3.6 36.0Z"/><path d="M38.9 36.0C39.2 31.5 41.9 29.1 43.0 26.1C44.1 29.1 41.6 31.5 41.3 36.0Z"/><path d="M11.5 36.0C11.4 31.1 10.9 28.4 12.1 25.1C13.2 28.4 14.0 31.1 14.0 36.0Z"/><path d="M44.5 36.0C44.8 29.0 48.2 25.1 49.3 20.4C50.4 25.1 48.4 29.0 48.1 36.0Z"/><path d="M4.2 36.0C4.5 28.3 7.6 24.0 8.7 18.9C9.8 24.0 8.4 28.3 8.2 36.0Z"/><path d="M23.5 36.0C24.0 27.4 29.6 22.6 30.7 16.8C31.8 22.6 28.4 27.4 27.9 36.0Z"/><path d="M18.5 36.0C18.6 27.0 20.4 22.0 21.5 16.0C22.7 22.0 23.2 27.0 23.1 36.0Z"/><path d="M27.6 36.0C28.0 26.4 32.5 21.0 33.6 14.6C34.8 21.0 32.9 26.4 32.5 36.0Z"/><path d="M11.8 36.0C10.5 21.5 1.5 13.4 2.6 3.7C3.8 13.4 17.9 21.5 19.2 36.0Z"/><path d="M31.8 36.0C31.3 20.4 29.9 11.7 31.0 1.2C32.2 11.7 39.3 20.4 39.8 36.0Z"/></g></svg>
         ${esc(club)} has ${sessionsOf(club,5).length} session(s) with 5+ shots. Session panels turn on at 6 —
         until then the ridgelines above carry the history.</p>`}
    </div>
  </section>

  <section class="block">
    <div class="blockhead"><h2>Session log</h2>
      <span class="sub">The raw summary behind every chart on this page.</span>
      <a class="btn act" href="#/data">All clubs →</a></div>
    <div class="panel"><div class="tablewrap"><table>
      <thead><tr><th>Date</th><th>Shots</th><th>Total</th><th>σ</th><th>Carry</th>
        <th>Side</th><th>|Side|</th><th>Smash</th><th>F2P</th><th>Path</th></tr></thead>
      <tbody>${sess.slice().reverse().map(ss=>{
        const q=mk=>quant(vals(ss.rows,METRICS[mk]),.5);
        return `<tr><td>${esc(fmtDY(ss.date))}</td><td>${ss.rows.length}</td>
          <td>${q('total').toFixed(0)}</td><td>${sd(vals(ss.rows,METRICS.total)).toFixed(1)}</td>
          <td>${q('carry').toFixed(0)}</td><td>${sgn(q('side'),0)}</td><td>${q('aside').toFixed(0)}</td>
          <td>${q('smash').toFixed(2)}</td><td>${sgn(q('f2p'),1)}</td><td>${sgn(q('path'),1)}</td></tr>`;
      }).join('')}</tbody></table></div>
      <p class="caption">Medians per session; σ is the standard deviation of total distance. Distances and side in
      yards, angles in degrees.</p></div>
  </section>
  `;
  app.querySelector('#tMetric')&&wireSeg(app,'tMetric',v=>{location.hash=href(v);});
  wireSeg(app,'tWin',v=>{rollWin=+v;render();});
  bindTips(app);
}
