<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Rough Estimates</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@500;700;800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
:root{
  color-scheme: light;
  --page:#f2f5ee; --surface:#fbfcf9; --surface-2:#f6f8f2; --sunk:#eceff0;
  --ink:#12150f; --ink-2:#4e5247; --ink-muted:#82867a;
  --rule:#dfe3d8; --rule-2:#c8cdbe; --ring:rgba(18,21,15,.10);
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100;
  --s5:#8659c9; --s6:#0d8f8f; --s7:#d84b8a; --s8:#6b7a1f;
  --brand:#2d6a3e; --ball:#fbfcf9;
  --pos:#2a78d6; --neg:#d03b3b;
  --good:#0ca30c; --crit:#d03b3b;
  --flag-bg:#fdf4e3; --flag-rule:#e0a93a;
  --r0:#9ec5f4; --r1:#86b6ef; --r2:#6da7ec; --r3:#5598e7; --r4:#3987e5;
  --r5:#2a78d6; --r6:#256abf; --r7:#1c5cab; --r8:#184f95; --r9:#104281;
}
@media (prefers-color-scheme: dark){ :root:where(:not([data-theme="light"])){
  color-scheme: dark;
  --page:#0d0f0b; --surface:#191c15; --surface-2:#1f2219; --sunk:#131610;
  --ink:#f4f6ef; --ink-2:#c2c7b6; --ink-muted:#8a8f80;
  --rule:#2b2f25; --rule-2:#3c4134; --ring:rgba(244,246,239,.12);
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500;
  --s5:#a685e0; --s6:#2fb8b8; --s7:#e8709f; --s8:#96a83a;
  --brand:#6ab573; --ball:#e9eee2;
  --pos:#3987e5; --neg:#e66767;
  --good:#0ca30c; --crit:#d03b3b;
  --flag-bg:#241d0e; --flag-rule:#8a6a1d;
  --r0:#1c5cab; --r1:#256abf; --r2:#2a78d6; --r3:#3987e5; --r4:#5598e7;
  --r5:#6da7ec; --r6:#86b6ef; --r7:#9ec5f4; --r8:#b7d3f6; --r9:#cde2fb;
}}
:root[data-theme="dark"]{
  color-scheme: dark;
  --page:#0d0f0b; --surface:#191c15; --surface-2:#1f2219; --sunk:#131610;
  --ink:#f4f6ef; --ink-2:#c2c7b6; --ink-muted:#8a8f80;
  --rule:#2b2f25; --rule-2:#3c4134; --ring:rgba(244,246,239,.12);
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500;
  --s5:#a685e0; --s6:#2fb8b8; --s7:#e8709f; --s8:#96a83a;
  --brand:#6ab573; --ball:#e9eee2;
  --pos:#3987e5; --neg:#e66767;
  --good:#0ca30c; --crit:#d03b3b;
  --flag-bg:#241d0e; --flag-rule:#8a6a1d;
  --r0:#1c5cab; --r1:#256abf; --r2:#2a78d6; --r3:#3987e5; --r4:#5598e7;
  --r5:#6da7ec; --r6:#86b6ef; --r7:#9ec5f4; --r8:#b7d3f6; --r9:#cde2fb;
}
*{box-sizing:border-box}
body{margin:0;background:var(--page);color:var(--ink);
  font-family:"IBM Plex Sans",system-ui,-apple-system,sans-serif;font-size:15px;line-height:1.6;
  -webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:"Alegreya Sans","Optima","Gill Sans",system-ui,sans-serif;font-weight:700;text-wrap:balance;margin:0;letter-spacing:-.015em}
a{color:inherit}
.mono,svg text{font-family:"IBM Plex Mono",ui-monospace,monospace}
.eyebrow{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--ink-muted)}

/* ---------- chrome ---------- */
.topbar{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--page) 88%,transparent);
  backdrop-filter:blur(10px);border-bottom:1px solid var(--rule-2)}
.topbar .in{max-width:1180px;margin:0 auto;padding:11px 24px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.brand{font-family:"Alegreya Sans","Optima","Gill Sans",sans-serif;font-weight:800;font-size:19px;
  letter-spacing:-.02em;text-decoration:none;display:flex;align-items:center}
.navlinks{display:flex;gap:4px;margin-left:auto;align-items:center}
.navlinks a{font-family:"Alegreya Sans","Optima","Gill Sans",sans-serif;font-weight:500;font-size:15px;
  text-decoration:none;color:var(--ink-2);padding:5px 11px;border-radius:5px}
.navlinks a:hover{background:var(--sunk)}
.navlinks a[aria-current="page"]{background:var(--ink);color:var(--page);font-weight:700}
.navlinks a:focus-visible,.brand:focus-visible{outline:2px solid var(--s1);outline-offset:2px}
.navlinks{position:relative}
.menu{position:relative}
.mtrigger{font-family:"Alegreya Sans","Optima","Gill Sans",sans-serif;font-weight:500;font-size:15px;
  color:var(--ink-2);background:transparent;border:0;
  padding:5px 11px;border-radius:5px;cursor:pointer;display:flex;align-items:center;gap:6px}
.mtrigger:hover{background:var(--sunk)}
.mtrigger:focus-visible{outline:2px solid var(--s1);outline-offset:2px}
.menu[data-active="true"] .mtrigger{background:var(--ink);color:var(--page);font-weight:700}
.mtrigger .caret{width:8px;height:8px;transition:transform .13s;flex:none}
.menu[data-open="true"] .mtrigger .caret{transform:rotate(180deg)}
.dropdown{position:absolute;top:calc(100% + 7px);left:0;min-width:216px;background:var(--surface);
  border:1px solid var(--rule-2);border-radius:8px;box-shadow:0 10px 28px var(--ring);
  padding:5px;display:none;z-index:45}
/* bridges the visual gap so the pointer never leaves the menu on its way down */
.dropdown::before{content:"";position:absolute;left:0;right:0;top:-11px;height:11px}
.menu[data-open="true"] .dropdown{display:block}
.dropdown a{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:5px;
  text-decoration:none;color:var(--ink-2);font-size:13.5px;white-space:nowrap}
.dropdown a:hover{background:var(--surface-2);color:var(--ink)}
.dropdown a[aria-current="page"]{background:var(--sunk);color:var(--ink);font-weight:600}
.dropdown a i{width:4px;height:17px;border-radius:2px;flex:none}
.dropdown a .n{margin-left:auto;font-family:"IBM Plex Mono",monospace;font-size:10.5px;color:var(--ink-muted)}
@media (max-width:700px){.dropdown{left:auto;right:0}}
.acct{display:flex;align-items:center;gap:10px;padding-left:6px;margin-left:6px;border-left:1px solid var(--rule)}
.acct .who{font-family:"IBM Plex Mono",monospace;font-size:11.5px;color:var(--ink-muted)}
.acct button{font:inherit;font-family:"IBM Plex Sans",sans-serif;font-size:12.5px;color:var(--ink-muted);
  background:none;border:0;padding:0;cursor:pointer;text-decoration:underline}
.acct button:hover{color:var(--ink)}
@media (max-width:700px){.acct{border-left:0;padding-left:0;margin-left:0;width:100%;justify-content:space-between}}

.shell{max-width:1180px;margin:0 auto;padding:0 24px 100px}
.crumbs{display:flex;gap:8px;align-items:center;padding:22px 0 0;font-size:13px;color:var(--ink-muted);
  font-family:"IBM Plex Mono",monospace}
.crumbs a{text-decoration:none;color:var(--ink-2)}
.crumbs a:hover{text-decoration:underline}
.crumbs .sep{opacity:.5}

.viewhead{padding:8px 0 4px}
.viewhead h1{font-size:clamp(26px,4vw,38px);line-height:1.08}
.viewhead .lede{max-width:64ch;color:var(--ink-2);margin-top:10px;font-size:16px}
.meta{font-family:"IBM Plex Mono",monospace;font-size:12px;color:var(--ink-muted);
  display:flex;flex-wrap:wrap;gap:0 22px;margin-top:12px}
.meta b{color:var(--ink-2);font-weight:500}

/* ---------- blocks ---------- */
section.block{margin-top:34px}
.blockhead{display:grid;grid-template-columns:1fr auto;align-items:baseline;
  column-gap:16px;row-gap:5px;padding-bottom:9px;border-bottom:1px solid var(--rule-2)}
.blockhead h2{grid-column:1;grid-row:1;font-size:21px}
.blockhead .act{grid-column:2;grid-row:1;align-self:center}
.blockhead .sub{grid-column:1/-1;grid-row:2;color:var(--ink-muted);font-size:12.5px;
  line-height:1.5;max-width:80ch}
.btn{font:inherit;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;
  padding:5px 12px;border:1px solid var(--rule-2);border-radius:6px;color:var(--ink-2);
  background:var(--surface);white-space:nowrap;cursor:pointer}
.btn:hover{border-color:var(--ink-muted);color:var(--ink)}
.btn:focus-visible{outline:2px solid var(--s1);outline-offset:1px}
.btn.primary{background:var(--ink);color:var(--page);border-color:var(--ink);font-weight:600}

.panel{margin-top:14px;background:var(--surface);border:1px solid var(--rule);border-radius:7px;overflow:hidden}
.controls{display:flex;flex-wrap:wrap;gap:10px 20px;align-items:center;
  padding:11px 16px;border-bottom:1px solid var(--rule);background:var(--surface-2)}
.ctl{display:flex;align-items:center;gap:8px}
.ctl>span{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.1em;
  text-transform:uppercase;color:var(--ink-muted)}
.seg{display:flex;flex-wrap:wrap;background:var(--sunk);border-radius:5px;padding:2px;gap:2px}
.seg button{font:inherit;font-size:13px;border:0;background:transparent;color:var(--ink-2);
  padding:4px 11px;border-radius:4px;cursor:pointer;white-space:nowrap}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);font-weight:600;box-shadow:0 1px 2px var(--ring)}
.seg button:focus-visible{outline:2px solid var(--s1);outline-offset:1px}
select{font:inherit;font-size:13px;padding:4px 8px;border:1px solid var(--rule-2);border-radius:5px;
  background:var(--surface);color:var(--ink)}
select:focus-visible{outline:2px solid var(--s1);outline-offset:1px}
.plot{padding:14px 16px 8px;overflow-x:auto}
svg{display:block;max-width:100%;height:auto}
svg text{font-size:10px;fill:var(--ink-muted)}
svg text.lbl{font-family:"IBM Plex Sans",sans-serif;font-size:11px;fill:var(--ink-2)}
svg text.val{font-size:11px;font-weight:500;fill:var(--ink-2)}
.grid-line{stroke:var(--rule);stroke-width:1}
.axis-line{stroke:var(--rule-2);stroke-width:1}
.caption{padding:2px 16px 15px;font-size:13px;color:var(--ink-muted);max-width:86ch}
.subhead{display:flex;align-items:baseline;gap:10px;padding:14px 16px 0}
.subhead h3{font-family:"Alegreya Sans","Optima","Gill Sans",sans-serif;font-weight:700;font-size:14.5px}
.subhead span{font-size:12.5px;color:var(--ink-muted)}
.divide{border-top:1px solid var(--rule);margin-top:10px}
.anchored{scroll-margin-top:70px}
.caption b{color:var(--ink-2);font-weight:500}
.legend{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;padding:0 16px 13px;font-size:12.5px;color:var(--ink-2)}
.legend .item{display:flex;align-items:center;gap:6px}
.legend .sw{width:12px;height:12px;border-radius:3px;flex:none}
.ramp{display:flex;align-items:center;gap:7px}
.ramp .bar{display:flex;height:11px;border-radius:2px;overflow:hidden}
.ramp .bar i{width:14px;height:100%}

/* ---------- club cards ---------- */
.cards{display:grid;gap:12px;margin-top:16px}
.clubcard{border:1px solid var(--rule);border-radius:7px;background:var(--surface);
  display:grid;grid-template-columns:186px 1fr;align-items:stretch;overflow:hidden;
  transition:border-color .12s, box-shadow .12s}
.clubcard:hover{border-color:var(--rule-2);box-shadow:0 2px 10px var(--ring)}
.clubcard .id{padding:14px 16px;border-right:1px solid var(--rule);background:var(--surface-2);
  text-decoration:none;display:flex;flex-direction:column;gap:2px}
.clubcard .id:focus-visible{outline:2px solid var(--s1);outline-offset:-2px}
.clubcard .id .nm{font-family:"Alegreya Sans","Optima","Gill Sans",sans-serif;font-weight:700;font-size:19px;display:flex;align-items:center;gap:8px}
.clubcard .id .nm .bar{width:4px;height:17px;border-radius:2px;flex:none}
.clubcard .id .sub{font-family:"IBM Plex Mono",monospace;font-size:10.5px;color:var(--ink-muted)}
.clubcard .id .go{margin-top:auto;font-size:12.5px;color:var(--ink-2);font-family:"IBM Plex Sans",sans-serif}
.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule)}
@media (max-width:820px){.metrics{grid-template-columns:repeat(2,1fr)}}
@media (max-width:460px){.metrics{grid-template-columns:1fr}}
.met{padding:11px 14px;background:var(--surface);display:flex;flex-direction:column;gap:4px;
  text-decoration:none}
.met:hover{background:var(--surface-2)}
.met:focus-visible{outline:2px solid var(--s1);outline-offset:-2px}
.met .k{font-family:"IBM Plex Mono",monospace;font-size:10px;letter-spacing:.07em;
  text-transform:uppercase;color:var(--ink-muted)}
.met .v{font-family:"Alegreya Sans","Optima","Gill Sans",sans-serif;font-size:20px;font-weight:700;line-height:1;
  font-variant-numeric:tabular-nums;display:flex;align-items:baseline;gap:5px;color:var(--ink)}
.met .v em{font-style:normal;font-size:11px;font-weight:400;color:var(--ink-muted);font-family:"IBM Plex Mono",monospace}
.chip{font-family:"IBM Plex Mono",monospace;font-size:10.5px;padding:1px 5px;border-radius:3px;
  display:inline-flex;align-items:center;gap:3px;width:fit-content}
.chip.up{color:var(--good);background:color-mix(in srgb,var(--good) 13%,transparent)}
.chip.dn{color:var(--crit);background:color-mix(in srgb,var(--crit) 13%,transparent)}
.chip.flat{color:var(--ink-muted);background:var(--sunk)}

/* ---------- club hero ---------- */
.hero{display:flex;align-items:flex-start;gap:18px;flex-wrap:wrap;padding-top:4px}
.hero .title{display:flex;align-items:center;gap:12px}
.hero .title .bar{width:6px;height:34px;border-radius:3px;flex:none}
.hero h1{font-size:clamp(28px,4vw,40px)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
  background:var(--rule);border:1px solid var(--rule);border-radius:7px;overflow:hidden;margin-top:18px}
@media (max-width:760px){.stats{grid-template-columns:repeat(2,1fr)}}
@media (max-width:430px){.stats{grid-template-columns:1fr}}
.statsnote{font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--ink-muted);margin-top:8px}
.stat{background:var(--surface);padding:12px 14px;display:flex;flex-direction:column;gap:4px;text-decoration:none}
.stat:hover{background:var(--surface-2)}
.stat:focus-visible{outline:2px solid var(--s1);outline-offset:-2px}
.stat .k{font-family:"IBM Plex Mono",monospace;font-size:10px;letter-spacing:.07em;
  text-transform:uppercase;color:var(--ink-muted)}
.stat .v{font-family:"Alegreya Sans","Optima","Gill Sans",sans-serif;font-size:23px;font-weight:700;line-height:1;
  font-variant-numeric:tabular-nums;display:flex;align-items:baseline;gap:5px}
.stat .v em{font-style:normal;font-size:11px;font-weight:400;color:var(--ink-muted);font-family:"IBM Plex Mono",monospace}

/* ---------- story ---------- */
.story{display:flex;gap:14px;align-items:flex-start;padding:13px 16px;background:var(--surface-2);
  border-bottom:1px solid var(--rule)}
.story .flagbar{width:3px;align-self:stretch;border-radius:2px;flex:none;background:var(--ink-muted)}
.story.up .flagbar{background:var(--good)} .story.dn .flagbar{background:var(--crit)}
.story p{margin:0;font-size:14.5px;color:var(--ink-2);max-width:84ch}
.story p b{color:var(--ink);font-weight:600}
.story .act{margin-left:auto;flex:none}

/* ---------- small multiples ---------- */
.mini-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:8px;padding:14px 16px}
.mini{border:1px solid var(--rule);border-radius:4px;padding:5px 5px 1px;background:var(--surface)}
.mini .t{font-family:"IBM Plex Mono",monospace;font-size:9px;color:var(--ink-muted);
  display:flex;justify-content:space-between;gap:4px;padding:0 1px 3px}

/* ---------- tables ---------- */
.tablewrap{overflow-x:auto;padding:0 2px 2px}
table{border-collapse:collapse;width:100%;font-size:13px;font-variant-numeric:tabular-nums}
th,td{padding:7px 12px;text-align:right;white-space:nowrap;border-bottom:1px solid var(--rule)}
th:first-child,td:first-child{text-align:left}
thead th{font-family:"IBM Plex Mono",monospace;font-size:10px;letter-spacing:.07em;text-transform:uppercase;
  color:var(--ink-muted);font-weight:400;border-bottom:1px solid var(--rule-2);
  position:sticky;top:0;background:var(--surface)}
tbody tr:hover{background:var(--surface-2)}
td a{text-decoration:none;font-weight:600}
td a:hover{text-decoration:underline}
.clubtag{display:inline-flex;align-items:center;gap:6px}
.clubtag i{width:8px;height:8px;border-radius:2px;flex:none}

.empty{padding:26px 16px;color:var(--ink-muted);font-size:14px;text-align:center}

#tip{position:fixed;pointer-events:none;opacity:0;transition:opacity .09s;z-index:60;
  background:var(--ink);color:var(--page);font-family:"IBM Plex Mono",monospace;font-size:11.5px;
  line-height:1.5;padding:7px 10px;border-radius:4px;max-width:270px;box-shadow:0 4px 14px rgba(0,0,0,.22)}

@media (max-width:700px){
  .shell,.topbar .in{padding-left:16px;padding-right:16px}
  .clubcard{grid-template-columns:1fr}
  .clubcard .id{border-right:0;border-bottom:1px solid var(--rule)}
  .story{flex-wrap:wrap}.story .act{margin-left:0;width:100%}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
.flashbar{max-width:1180px;margin:10px auto 0;padding:0 24px}
.flashbar .notice,.flashbar .alert{font-family:"IBM Plex Sans",sans-serif;font-size:13px;
  padding:8px 12px;border-radius:6px;margin-bottom:8px}
.flashbar .notice{background:var(--flag-bg);color:var(--ink)}
.flashbar .alert{background:rgba(208,59,59,.12);color:var(--crit)}
@media (max-width:700px){.flashbar{padding-left:16px;padding-right:16px}}
</style>

<% if flash.any? %>
  <div class="flashbar">
    <% flash.each do |type, message| %>
      <div class="<%= type == "notice" ? "notice" : "alert" %>"><%= message %></div>
    <% end %>
  </div>
<% end %>

<div class="topbar"><div class="in">
  <a class="brand" href="#/">Rough estimates</a>
  <nav class="navlinks" id="nav">
    <a href="#/">Overview</a>
    <div class="menu" id="clubmenu" data-open="false">
      <button type="button" class="mtrigger" id="clubbtn" aria-expanded="false" aria-haspopup="true" aria-controls="clubdrop">
        Clubs
        <svg class="caret" viewBox="0 0 10 7" aria-hidden="true"><path d="M1 1.5 L5 5.5 L9 1.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="dropdown" id="clubdrop" role="menu"></div>
    </div>
    <a href="#/data">Raw data</a>
    <a href="<%= trackman_sessions_path %>">Sessions →</a>
    <div class="acct">
      <span class="who"><%= current_user.email %></span>
      <%= button_to "Log out", logout_path, method: :delete, form: { style: "display:inline" } %>
    </div>
  </nav>
</div></div>

<div class="shell" id="app"></div>
<div id="tip" role="status" aria-live="polite"></div>
<script>
const DATA = <%= raw @data_json %>;
const C={date:0,club:1,carry:2,total:3,side:4,smash:5,f2p:6,path:7,face:8,cs:9};
const ROWS=DATA.rows, DATES=DATA.dates, CLUBS=DATA.clubs;

/* ================= stats ================= */
const mean=a=>a.reduce((s,x)=>s+x,0)/a.length;
const sd=a=>{if(a.length<2)return 0;const m=mean(a);return Math.sqrt(a.reduce((s,x)=>s+(x-m)**2,0)/(a.length-1));};
function quant(a,p){if(!a.length)return 0;const s=[...a].sort((x,y)=>x-y),i=(s.length-1)*p,
  lo=Math.floor(i),hi=Math.ceil(i);return lo===hi?s[lo]:s[lo]+(s[hi]-s[lo])*(i-lo);}
const day=d=>Date.UTC(+d.slice(0,4),+d.slice(5,7)-1,+d.slice(8,10))/864e5;
const fmtD=d=>new Date(day(d)*864e5).toLocaleDateString('en-US',{month:'short',day:'numeric',timeZone:'UTC'});
const fmtDY=d=>new Date(day(d)*864e5).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'});
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const sgn=(v,d)=>(v>0?'+':v<0?'−':'')+Math.abs(v).toFixed(d);

function ellipse(pts,k=1.5136){
  const n=pts.length; if(n<3)return null;
  const mx=mean(pts.map(p=>p[0])), my=mean(pts.map(p=>p[1]));
  let a=0,b=0,c=0;
  for(const p of pts){a+=(p[0]-mx)**2;b+=(p[0]-mx)*(p[1]-my);c+=(p[1]-my)**2;}
  a/=(n-1);b/=(n-1);c/=(n-1);
  const tr=a+c,det=a*c-b*b,s=Math.sqrt(Math.max(0,tr*tr/4-det));
  const l1=tr/2+s,l2=Math.max(1e-9,tr/2-s);
  let v1=Math.abs(b)>1e-9?[b,l1-a]:(a>=c?[1,0]:[0,1]);
  const nv=Math.hypot(v1[0],v1[1]); v1=[v1[0]/nv,v1[1]/nv];
  return {mx,my,ax:k*Math.sqrt(Math.max(l1,1e-9)),bx:k*Math.sqrt(l2),v1,v2:[-v1[1],v1[0]]};
}
function ellipsePath(e,sx,sy,steps=72){
  let d='';
  for(let i=0;i<=steps;i++){const t=i/steps*2*Math.PI;
    const x=e.mx+e.ax*Math.cos(t)*e.v1[0]+e.bx*Math.sin(t)*e.v2[0];
    const y=e.my+e.ax*Math.cos(t)*e.v1[1]+e.bx*Math.sin(t)*e.v2[1];
    d+=(i?'L':'M')+sx(x).toFixed(1)+' '+sy(y).toFixed(1);}
  return d+'Z';
}
const kde=(v,grid,bw)=>{const n=v.length,f=1/(n*bw*Math.sqrt(2*Math.PI));
  return grid.map(g=>{let s=0;for(const x of v){const z=(g-x)/bw;s+=Math.exp(-0.5*z*z);}return s*f;});};
const silverman=v=>{const s=sd(v),iqr=quant(v,.75)-quant(v,.25);
  return 0.9*Math.min(s||1,(iqr||s||1)/1.349)*Math.pow(v.length,-0.2)||1;};

/* ================= model ================= */
const METRICS={
  total:{k:C.total,label:'Total distance',short:'Total',unit:' yd',dec:1,dir:1,
         head:'Distance',blurb:'How far it actually goes, session by session.'},
  carry:{k:C.carry,label:'Carry',short:'Carry',unit:' yd',dec:1,dir:1,
         head:'Carry',blurb:'Distance through the air — the number that clears a bunker.'},
  aside:{k:C.side,label:'Side miss',short:'Side miss',unit:' yd',dec:1,abs:true,dir:-1,
         head:'How far offline',blurb:'Absolute distance from the target line, regardless of direction.'},
  side :{k:C.side,label:'Side (+right)',short:'Side L/R',unit:' yd',dec:1,dir:0,target:0,
         head:'Which way it misses',blurb:'Signed offline distance — right is positive.'},
  smash:{k:C.smash,label:'Smash factor',short:'Smash',unit:'',dec:3,dir:1,
         head:'Strike quality',blurb:'Ball speed over club speed. A centred strike, in one number.'},
  f2p  :{k:C.f2p,label:'Face-to-path',short:'F2P',unit:'°',dec:2,dir:0,target:-1,
         head:'Face-to-path',blurb:'Where the face points relative to the swing path — the curve you get.'},
  path :{k:C.path,label:'Club path',short:'Path',unit:'°',dec:2,dir:0,target:0,
         head:'Club path',blurb:'In-to-out or out-to-in through impact.'},
};
const METRIC_KEYS=['total','carry','aside','smash','f2p','path','side'];
const TREND_KEYS=['total','carry','aside','side','smash','f2p','path'];
const STORY_KEYS=['total','aside','f2p','smash'];
const CARD_KEYS=['carry','total','aside','smash','path','f2p'];

const clubRows=c=>ROWS.filter(r=>CLUBS[r[C.club]]===c);
const CLUB_LIST=CLUBS.filter(c=>clubRows(c).length>=60);
const LOFT_ORDER=['Driver','2Wood','3Wood','4Wood','5Wood','7Wood',
  '2Hybrid','3Hybrid','4Hybrid','5Hybrid',
  '1Iron','2Iron','3Iron','4Iron','5Iron','6Iron','7Iron','8Iron','9Iron',
  'PitchingWedge','GapWedge','SandWedge','LobWedge','Putter'];
const byLoft=(a,b)=>LOFT_ORDER.indexOf(a)-LOFT_ORDER.indexOf(b);
/* cycles through a fixed categorical palette in bag order, so colors stay
   consistent across renders regardless of which subset of clubs is loaded */
const PALETTE=['var(--s1)','var(--s2)','var(--s3)','var(--s4)','var(--s5)','var(--s6)','var(--s7)','var(--s8)'];
// indexed by rank among clubs actually present (not raw loft position) so a
// bag of, say, driver+3wood+irons doesn't skip straight to color collisions
// from unused slots in the middle of LOFT_ORDER
let CLUB_RANK={};
const CLUB_COLOR=new Proxy({}, {get:(_,club)=>PALETTE[(CLUB_RANK[club]||0)%PALETTE.length]});
CLUB_LIST.slice().sort(byLoft).forEach((c,i)=>{CLUB_RANK[c]=i;});
const RAMP=[...Array(10)].map((_,i)=>`var(--r${i})`);
const rampAt=(i,n)=>RAMP[n<=1?9:Math.round(i/(n-1)*9)];
const vals=(rows,m)=>rows.map(r=>r[m.k]).filter(v=>v!=null).map(v=>m.abs?Math.abs(v):v);
/* headline precision: smash needs 2dp, angles 1dp, distances none */
const fmtV=(m,v)=>v.toFixed(m.dec===3?2:(m.unit==='°'?1:0));

function sessionsOf(club,minN=1){
  const by=new Map();
  for(const r of clubRows(club)){const d=DATES[r[C.date]];if(!by.has(d))by.set(d,[]);by.get(d).push(r);}
  return [...by.entries()].filter(([,v])=>v.length>=minN).sort((a,b)=>a[0]<b[0]?-1:1)
    .map(([d,v])=>({date:d,rows:v}));
}
/* improvement in the direction that is actually better for this measure */
function improve(m,cur,prev){
  if(m.dir===1)return cur-prev;
  if(m.dir===-1)return prev-cur;
  const t=m.target||0; return Math.abs(prev-t)-Math.abs(cur-t);
}
/* pooled shots across a run of sessions, with the standard error of its mean */
function blockStat(sessArr,m){
  const v=sessArr.flatMap(ss=>vals(ss.rows,m));
  return {mu:mean(v), sd:sd(v), se:sd(v)/Math.sqrt(Math.max(1,v.length)), n:v.length};
}
/* two blocks differ only if the gap clears the 95% interval of the difference */
const diffSig=(a,b)=>Math.abs(a.mu-b.mu) > 1.96*Math.sqrt(a.se*a.se+b.se*b.se);
function story(club,mk){
  const m=METRICS[mk], sess=sessionsOf(club,3);
  if(sess.length<4)return null;
  const k=Math.max(1,Math.min(3,Math.floor(sess.length/3)));
  const early=blockStat(sess.slice(0,k),m), late=blockStat(sess.slice(-k),m);
  const mid=blockStat(sess.slice(-2*k,-k),m);
  const sigA=diffSig(late,early), sigR=diffSig(late,mid);
  const allImp=improve(m,late.mu,early.mu), recImp=improve(m,late.mu,mid.mu);
  const u=m.unit.trim(), d=m.dec===3?3:1;
  const word=v=>v>0?'better':'worse';
  let txt=`Across ${sess.length} sessions this is <b>${sigA?word(allImp):'flat'}</b>`;
  txt+= sigA ? ` — ${Math.abs(late.mu-early.mu).toFixed(d)}${u} of movement, from ${early.mu.toFixed(d)} to ${late.mu.toFixed(d)}${u}.`
             : ` — the ${Math.abs(late.mu-early.mu).toFixed(d)}${u} between the first and last ${k} sessions is inside sampling noise.`;
  txt+= sigR ? ` The last ${k} sessions are still moving, ${Math.abs(late.mu-mid.mu).toFixed(d)}${u} ${word(recImp)} than the ${k} before them.`
             : ` Recent sessions have <b>stopped moving</b> — the last ${k} sit within noise of the ${k} before them.`;
  if(early.sd>0&&late.sd>0){
    const pc=(late.sd/early.sd-1)*100;
    txt+= Math.abs(pc)<8 ? ` Spread is unchanged at σ ${late.sd.toFixed(d)}.`
        : ` Spread has <b>${pc<0?'tightened':'widened'}</b> from σ ${early.sd.toFixed(d)} to σ ${late.sd.toFixed(d)}.`;
  }
  return {txt, tone:!sigA?'flat':allImp>0?'up':'dn'};
}

/* ================= tooltips & controls ================= */
const tip=document.getElementById('tip');
function bindTips(root){
  root.querySelectorAll('[data-tip]').forEach(el=>{
    el.addEventListener('pointerenter',()=>{tip.innerHTML=el.dataset.tip;tip.style.opacity='1';});
    el.addEventListener('pointermove',e=>{
      tip.style.left=Math.min(innerWidth-tip.offsetWidth-8,Math.max(8,e.clientX+14))+'px';
      tip.style.top=Math.max(8,e.clientY-tip.offsetHeight-12)+'px';});
    el.addEventListener('pointerleave',()=>{tip.style.opacity='0';});
  });
}
function wireSeg(root,id,onPick){
  const el=root.querySelector('#'+id); if(!el)return;
  el.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
    [...el.children].forEach(x=>x.setAttribute('aria-pressed',String(x===b)));onPick(b.dataset.v);});
}
const segHTML=(id,opts,cur)=>`<div class="seg" id="${id}">`+
  opts.map(o=>`<button data-v="${esc(o[0])}" aria-pressed="${String(o[0]===cur)}">${esc(o[1])}</button>`).join('')+`</div>`;
const selHTML=(id,opts,cur)=>`<select id="${id}">`+
  opts.map(o=>`<option value="${esc(o[0])}"${o[0]===cur?' selected':''}>${esc(o[1])}</option>`).join('')+`</select>`;

/* ================= chart: gapping ridgeline ================= */
function gappingSVG(metricKey,windowDays){
  const key=metricKey==='total'?C.total:C.carry;
  const order=CLUB_LIST.slice().sort(byLoft);
  // recent gapping only -- an old swing/club change shouldn't blend into where
  // the bag actually lands today. Fall back to all-time if the window is too
  // narrow to say anything (e.g. nothing hit in the last N days).
  const maxDay=day(ALL_SESSIONS[ALL_SESSIONS.length-1]);
  const cutoff=windowDays?maxDay-windowDays+1:-Infinity;
  const rowsFor=cut=>order.map(c=>({club:c,
    v:clubRows(c).filter(r=>day(DATES[r[C.date]])>=cut).map(r=>r[key]).filter(v=>v!=null)}))
    .filter(sr=>sr.v.length>0);
  let ser=rowsFor(cutoff), windowed=!!windowDays;
  if(windowDays&&!ser.length){ser=rowsFor(-Infinity);windowed=false;}
  const flat=ser.flatMap(s=>s.v), lo=Math.min(...flat)-8, hi=Math.max(...flat)+8;
  const rowH=70, amp=50, W=1000, P={l:104,r:24,t:16,b:40};
  const H=P.t+rowH*ser.length+P.b;
  const grid=[...Array(200)].map((_,i)=>lo+(hi-lo)*i/199);
  const sx=v=>P.l+((v-lo)/(hi-lo))*(W-P.l-P.r);
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="distance distribution by club">`;
  const step=20;
  for(let t=Math.ceil(lo/step)*step;t<=hi;t+=step){
    s+=`<line x1="${sx(t).toFixed(1)}" y1="${P.t}" x2="${sx(t).toFixed(1)}" y2="${H-P.b}" class="grid-line"/>`;
    s+=`<text x="${sx(t).toFixed(1)}" y="${H-P.b+16}" text-anchor="middle">${t}</text>`;
  }
  s+=`<text x="${W-P.r}" y="${H-P.b+31}" text-anchor="end" class="lbl">yards →</text>`;
  const rows=ser.map((sr,i)=>{
    const bw=silverman(sr.v), dens=kde(sr.v,grid,bw), mx=Math.max(...dens), base=P.t+rowH*(i+1);
    return {sr,base,col:CLUB_COLOR[sr.club],
      path:'M'+sx(grid[0]).toFixed(1)+' '+base+dens.map((d,j)=>'L'+sx(grid[j]).toFixed(1)+' '+(base-d/mx*amp).toFixed(1)).join('')+'L'+sx(grid[199]).toFixed(1)+' '+base+'Z',
      med:quant(sr.v,.5),p25:quant(sr.v,.25),p75:quant(sr.v,.75),p10:quant(sr.v,.10),p90:quant(sr.v,.90)};
  });
  for(let i=rows.length-1;i>=0;i--){
    const r=rows[i];
    s+=`<path d="${r.path}" fill="var(--surface)"/>`;
    s+=`<a href="#/club/${esc(r.sr.club)}" style="cursor:pointer">`;
    s+=`<path d="${r.path}" fill="${r.col}" fill-opacity=".24" stroke="${r.col}" stroke-width="2" stroke-linejoin="round"
        data-tip="${esc(`<b>${r.sr.club}</b> · ${r.sr.v.length} shots<br>median ${r.med.toFixed(0)} yd<br>P25–P75 ${r.p25.toFixed(0)}–${r.p75.toFixed(0)} yd<br>σ ${sd(r.sr.v).toFixed(1)} yd<br><i>click to open ${r.sr.club}</i>`)}"/>`;
    s+=`</a>`;
    s+=`<line x1="${sx(r.med).toFixed(1)}" y1="${r.base}" x2="${sx(r.med).toFixed(1)}" y2="${r.base-32}" stroke="${r.col}" stroke-width="2.5"/>`;
    s+=`<line x1="${sx(r.p25).toFixed(1)}" y1="${r.base-5}" x2="${sx(r.p75).toFixed(1)}" y2="${r.base-5}" stroke="var(--ink-muted)" stroke-width="1.5"/>`;
    s+=`<text x="${P.l-12}" y="${r.base-3}" text-anchor="end" class="lbl" style="font-weight:600;fill:var(--ink)">${esc(r.sr.club)}</text>`;
    s+=`<text x="${P.l-12}" y="${r.base+11}" text-anchor="end">${r.sr.v.length} shots</text>`;
  }
  const laps=[];
  for(let i=0;i<rows.length-1;i++){
    const lng=rows[i],sht=rows[i+1];
    if(sht.p90>lng.p10) laps.push(`<b>${sht.sr.club}/${lng.sr.club}</b> overlap ${(sht.p90-lng.p10).toFixed(0)} yd`);
  }
  return {svg:s+'</svg>', laps, windowed, n:flat.length};
}

/* ================= chart: ridgeline timeline ================= */
function ridgeSVG(club,mk,opts={}){
  const m=METRICS[mk], sess=sessionsOf(club,3);
  if(sess.length<3)return null;
  const all=vals(clubRows(club),m);
  const padv=(mk==='smash')?0.03:(m.unit==='°'?1.5:4);
  const lo=quant(all,.005)-padv, hi=quant(all,.995)+padv;
  const rowH=opts.rowH||17, amp=opts.amp||Math.round(rowH*0.82), W=1000, P={l:94,r:66,t:16,b:38};
  const H=P.t+rowH*sess.length+amp+P.b;
  const grid=[...Array(180)].map((_,i)=>lo+(hi-lo)*i/179);
  const sx=v=>P.l+((Math.max(lo,Math.min(hi,v))-lo)/(hi-lo))*(W-P.l-P.r);
  const span=hi-lo;
  const step=mk==='smash'?0.1:(span>120?40:span>50?20:span>16?4:2);
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(m.label)} by session">`;
  for(let t=Math.ceil(lo/step)*step;t<=hi;t+=step){
    s+=`<line x1="${sx(t).toFixed(1)}" y1="${P.t}" x2="${sx(t).toFixed(1)}" y2="${H-P.b}" class="grid-line"/>`;
    s+=`<text x="${sx(t).toFixed(1)}" y="${H-P.b+16}" text-anchor="middle">${mk==='smash'?t.toFixed(2):(Math.abs(step)<4?t.toFixed(1):t.toFixed(0))}</text>`;
  }
  if(m.target!=null&&m.target>lo&&m.target<hi){
    s+=`<line x1="${sx(m.target).toFixed(1)}" y1="${P.t}" x2="${sx(m.target).toFixed(1)}" y2="${H-P.b}" class="axis-line" stroke-dasharray="3 3"/>`;
    s+=`<text x="${sx(m.target).toFixed(1)}" y="${P.t-4}" text-anchor="middle" class="val">target</text>`;
  }
  s+=`<text x="${W-P.r}" y="${H-P.b+31}" text-anchor="end" class="lbl">${esc(m.label+m.unit)} →</text>`;
  for(let i=sess.length-1;i>=0;i--){
    const ss=sess[i], v=vals(ss.rows,m), base=P.t+amp+rowH*i, col=rampAt(i,sess.length), med=quant(v,.5);
    const tt=`<b>${fmtD(ss.date)}</b> · ${v.length} shots<br>median ${med.toFixed(m.dec)}${m.unit}<br>σ ${sd(v).toFixed(m.dec)}`;
    if(v.length<8){
      s+=`<g data-tip="${esc(tt)}" style="cursor:crosshair"><rect x="${P.l}" y="${base-9}" width="${W-P.l-P.r}" height="12" fill="transparent"/>`;
      v.forEach(x=>{s+=`<circle cx="${sx(x).toFixed(1)}" cy="${(base-4).toFixed(1)}" r="2.6" fill="${col}" stroke="var(--surface)" stroke-width="1.2"/>`;});
      s+=`</g>`;
    }else{
      const dens=kde(v,grid,silverman(v)), mx=Math.max(...dens);
      const path='M'+sx(grid[0]).toFixed(1)+' '+base+dens.map((d,j)=>'L'+sx(grid[j]).toFixed(1)+' '+(base-d/mx*amp).toFixed(1)).join('')+'L'+sx(grid[179]).toFixed(1)+' '+base+'Z';
      s+=`<path d="${path}" fill="var(--surface)"/>`;
      s+=`<path d="${path}" fill="${col}" fill-opacity=".55" stroke="${col}" stroke-width="1.5" stroke-linejoin="round" data-tip="${esc(tt)}" style="cursor:crosshair"/>`;
    }
    s+=`<line x1="${sx(med).toFixed(1)}" y1="${base+1}" x2="${sx(med).toFixed(1)}" y2="${base-7}" stroke="var(--ink)" stroke-width="1.4" stroke-opacity=".5"/>`;
    s+=`<text x="${P.l-10}" y="${base+1}" text-anchor="end">${esc(fmtD(ss.date))}</text>`;
    s+=`<text x="${W-P.r+8}" y="${base+1}">${v.length}</text>`;
  }
  s+=`<text x="${W-P.r+8}" y="${P.t+amp-rowH+1}" class="lbl">shots</text></svg>`;
  return {svg:s, sess};
}

/* ================= chart: small multiples ================= */
function multiplesHTML(club){
  const sess=sessionsOf(club,5);
  if(sess.length<6)return null;
  let xmax=0; const sides=[];
  for(const s of sess)for(const r of s.rows){xmax=Math.max(xmax,r[C.total]);sides.push(Math.abs(r[C.side]));}
  const sc={xmax:Math.ceil(xmax*1.06/20)*20, ymax:Math.max(30,Math.ceil(quant(sides,.97)*1.06/10)*10)};
  const W=120,H=80,P={l:3,r:3,t:3,b:11};
  const sx=v=>P.l+(Math.min(v,sc.xmax)/sc.xmax)*(W-P.l-P.r);
  const sy=v=>P.t+(H-P.t-P.b)*(0.5-Math.max(-sc.ymax,Math.min(sc.ymax,v))/(2*sc.ymax));
  const html=sess.map((ss,i)=>{
    const pts=ss.rows.map(r=>[r[C.total],r[C.side]]);
    const e=ellipse(pts), col=rampAt(i,sess.length), med=quant(pts.map(p=>p[0]),.5);
    const tt=`<b>${fmtD(ss.date)}</b> · ${ss.rows.length} shots<br>median ${med.toFixed(0)} yd<br>side ${sgn(mean(ss.rows.map(r=>r[C.side])),1)} yd`+
             (e?`<br>68% oval ${(2*e.ax).toFixed(0)} yd × ${(2*e.bx).toFixed(0)} yd`:'');
    return `<div class="mini"><div class="t"><span>${esc(fmtD(ss.date))}</span><span>${ss.rows.length}</span></div>
      <svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(ss.date)} dispersion" data-tip="${esc(tt)}" style="cursor:crosshair">
        <line x1="${P.l}" y1="${sy(0).toFixed(1)}" x2="${W-P.r}" y2="${sy(0).toFixed(1)}" class="axis-line"/>
        ${e?`<path d="${ellipsePath(e,sx,sy,40)}" fill="${col}" fill-opacity=".16" stroke="${col}" stroke-width="1.2"/>`:''}
        ${pts.map(p=>`<circle cx="${sx(p[0]).toFixed(1)}" cy="${sy(p[1]).toFixed(1)}" r="1.4" fill="${col}" fill-opacity=".85"/>`).join('')}
        <text x="${W-P.r}" y="${H-2.5}" text-anchor="end" style="font-size:8.5px">${med.toFixed(0)} yd</text>
      </svg></div>`;
  }).join('');
  return {html:`<div class="mini-grid">${html}</div>`, sc, sess};
}

/* ================= chart: rolling mean + slope ================= */
function rollingSVG(club,mk,win){
  const m=METRICS[mk];
  const rows=clubRows(club).filter(r=>r[m.k]!=null)
    .map(r=>({t:day(DATES[r[C.date]]),v:m.abs?Math.abs(r[m.k]):r[m.k]})).sort((a,b)=>a.t-b.t);
  if(rows.length<30)return null;
  const w=Math.max(8,Math.min(win,Math.floor(rows.length/3))), half=Math.floor(w/2), roll=[];
  for(let i=half;i<rows.length-half;i++){
    const win2=rows.slice(i-half,i+half+1), vv=win2.map(p=>p.v), tt=win2.map(p=>p.t);
    const mu=mean(vv), mt=mean(tt); let num=0,den=0;
    for(let j=0;j<win2.length;j++){num+=(tt[j]-mt)*(vv[j]-mu);den+=(tt[j]-mt)**2;}
    roll.push({t:rows[i].t,mu,s:sd(vv),slope:den>1e-6?num/den*30.44:0});
  }
  const W=1000,P={l:56,r:16,t:16,b:26},H1=248,GAP=18,H2=112;
  const H=H1+GAP+H2+P.b+14;
  const t0=rows[0].t,t1=rows[rows.length-1].t;
  const sx=t=>P.l+((t-t0)/(t1-t0))*(W-P.l-P.r);
  const vlo=quant(rows.map(r=>r.v),.01),vhi=quant(rows.map(r=>r.v),.99),pad=(vhi-vlo)*.12;
  const y0=vlo-pad,y1=vhi+pad;
  const sy=v=>P.t+(H1-P.t)*(1-(Math.max(y0,Math.min(y1,v))-y0)/(y1-y0));
  const smax=quant(roll.map(r=>Math.abs(r.slope)),.98)*1.15||1;
  const yb=H1+GAP, sy2=v=>yb+H2/2-(Math.max(-smax,Math.min(smax,v))/smax)*(H2/2-8);
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="rolling mean and rate of change">`;
  for(let i=0;i<=4;i++){const v=y0+(y1-y0)*i/4,y=sy(v);
    s+=`<line x1="${P.l}" y1="${y.toFixed(1)}" x2="${W-P.r}" y2="${y.toFixed(1)}" class="grid-line"/>`;
    s+=`<text x="${P.l-8}" y="${(y+3).toFixed(1)}" text-anchor="end">${v.toFixed(m.dec===3?2:0)}</text>`;}
  for(let d=new Date(t0*864e5);d<=new Date(t1*864e5);d.setUTCMonth(d.getUTCMonth()+1)){
    const dd=Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),1)/864e5; if(dd<t0||dd>t1)continue;
    s+=`<line x1="${sx(dd).toFixed(1)}" y1="${P.t}" x2="${sx(dd).toFixed(1)}" y2="${yb+H2}" class="grid-line"/>`;
    s+=`<text x="${sx(dd).toFixed(1)}" y="${yb+H2+16}" text-anchor="middle">${new Date(dd*864e5).toLocaleDateString('en-US',{month:'short',timeZone:'UTC'})}</text>`;}
  rows.forEach(r=>{s+=`<circle cx="${sx(r.t).toFixed(1)}" cy="${sy(r.v).toFixed(1)}" r="1.9" fill="var(--ink-muted)" fill-opacity=".3"/>`;});
  const up=roll.map(r=>sx(r.t).toFixed(1)+','+sy(r.mu+r.s).toFixed(1));
  const dn=roll.map(r=>sx(r.t).toFixed(1)+','+sy(r.mu-r.s).toFixed(1)).reverse();
  s+=`<polygon points="${up.concat(dn).join(' ')}" fill="${CLUB_COLOR[club]}" fill-opacity=".13"/>`;
  s+=`<polyline points="${roll.map(r=>sx(r.t).toFixed(1)+','+sy(r.mu).toFixed(1)).join(' ')}" fill="none" stroke="${CLUB_COLOR[club]}" stroke-width="2.4" stroke-linejoin="round"/>`;
  s+=`<text x="${P.l}" y="${P.t-3}" class="lbl">${esc(m.label+m.unit)} · rolling mean of ${w} shots, ±1σ</text>`;
  s+=`<line x1="${P.l}" y1="${sy2(0).toFixed(1)}" x2="${W-P.r}" y2="${sy2(0).toFixed(1)}" class="axis-line"/>`;
  let buf=[];
  const flush=()=>{ if(buf.length<2){buf=[];return;}
    const pos=mean(buf.map(x=>x.slope))>0;
    s+=`<polygon points="${sx(buf[0].t).toFixed(1)},${sy2(0).toFixed(1)} ${buf.map(x=>sx(x.t).toFixed(1)+','+sy2(x.slope).toFixed(1)).join(' ')} ${sx(buf[buf.length-1].t).toFixed(1)},${sy2(0).toFixed(1)}" fill="${pos?'var(--pos)':'var(--neg)'}" fill-opacity=".3"/>`;
    buf=[];};
  roll.forEach((r,i)=>{ if(!i)return; const p=roll[i-1];
    if(buf.length&&Math.sign(p.slope)!==Math.sign(r.slope))flush();
    if(!buf.length)buf.push(p); buf.push(r);});
  flush();
  s+=`<polyline points="${roll.map(r=>sx(r.t).toFixed(1)+','+sy2(r.slope).toFixed(1)).join(' ')}" fill="none" stroke="var(--ink-2)" stroke-width="1.5"/>`;
  const sdec=smax<0.05?3:(smax<0.5?2:(m.dec===3?3:1));
  [smax*.6,-smax*.6].forEach(v=>{s+=`<text x="${P.l-8}" y="${(sy2(v)+3).toFixed(1)}" text-anchor="end">${sgn(v,sdec)}</text>`;});
  s+=`<text x="${P.l-8}" y="${(sy2(0)+3).toFixed(1)}" text-anchor="end">0</text>`;
  s+=`<text x="${P.l}" y="${yb-4}" class="lbl">rate of change · ${esc(m.unit.trim()||'×')} per month</text></svg>`;
  const q=Math.max(3,Math.floor(roll.length*.25));
  return {svg:s, w, n:rows.length,
    early:mean(roll.slice(0,q).map(r=>r.slope)), recent:mean(roll.slice(-q).map(r=>r.slope)),
    sdec:(smax<0.05?3:(smax<0.5?2:(m.dec===3?3:1)))};
}

/* ================= chart: believability ================= */
function noiseSVG(club,mk){
  const m=METRICS[mk];
  const sess=sessionsOf(club,2).map(ss=>{const v=vals(ss.rows,m);
    return {date:ss.date,t:day(ss.date),n:v.length,mu:mean(v),se:sd(v)/Math.sqrt(v.length)};});
  if(sess.length<4)return null;
  const trail=sess.map((_,i)=>mean(sess.slice(Math.max(0,i-4),i+1).map(x=>x.mu)));
  const W=1000,H=320,P={l:56,r:18,t:18,b:44};
  const t0=sess[0].t,t1=sess[sess.length-1].t;
  const sx=t=>P.l+((t-t0)/(t1-t0))*(W-P.l-P.r);
  const lo=Math.min(...sess.map(s=>s.mu-1.96*s.se)),hi=Math.max(...sess.map(s=>s.mu+1.96*s.se));
  const pad=(hi-lo)*.1, y0=lo-pad, y1=hi+pad;
  const sy=v=>P.t+(H-P.b-P.t)*(1-(v-y0)/(y1-y0));
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="session means with confidence intervals">`;
  for(let i=0;i<=4;i++){const v=y0+(y1-y0)*i/4,y=sy(v);
    s+=`<line x1="${P.l}" y1="${y.toFixed(1)}" x2="${W-P.r}" y2="${y.toFixed(1)}" class="grid-line"/>`;
    s+=`<text x="${P.l-8}" y="${(y+3).toFixed(1)}" text-anchor="end">${v.toFixed(m.dec===3?2:0)}</text>`;}
  for(let d=new Date(t0*864e5);d<=new Date(t1*864e5);d.setUTCMonth(d.getUTCMonth()+1)){
    const dd=Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),1)/864e5; if(dd<t0||dd>t1)continue;
    s+=`<line x1="${sx(dd).toFixed(1)}" y1="${P.t}" x2="${sx(dd).toFixed(1)}" y2="${H-P.b}" class="grid-line"/>`;
    s+=`<text x="${sx(dd).toFixed(1)}" y="${H-P.b+16}" text-anchor="middle">${new Date(dd*864e5).toLocaleDateString('en-US',{month:'short',timeZone:'UTC'})}</text>`;}
  s+=`<polyline points="${sess.map((x,i)=>sx(x.t).toFixed(1)+','+sy(trail[i]).toFixed(1)).join(' ')}" fill="none" stroke="var(--ink-muted)" stroke-width="2" stroke-dasharray="5 4"/>`;
  let nSig=0;
  sess.forEach((x,i)=>{
    const t=trail[i], sig=(x.mu-1.96*x.se>t)||(x.mu+1.96*x.se<t); if(sig)nSig++;
    const better=improve(m,x.mu,t)>0;
    const col=!sig?'var(--ink-muted)':(better?'var(--pos)':'var(--neg)'), X=sx(x.t);
    s+=`<line x1="${X.toFixed(1)}" y1="${sy(x.mu-1.96*x.se).toFixed(1)}" x2="${X.toFixed(1)}" y2="${sy(x.mu+1.96*x.se).toFixed(1)}" stroke="${col}" stroke-width="1.6" stroke-opacity=".7"/>`;
    s+=`<circle cx="${X.toFixed(1)}" cy="${sy(x.mu).toFixed(1)}" r="${(2.1+Math.sqrt(x.n)*.52).toFixed(1)}" fill="${col}" fill-opacity="${sig?'.95':'.45'}" stroke="var(--surface)" stroke-width="1.6" style="cursor:crosshair"
      data-tip="${esc(`<b>${fmtD(x.date)}</b> · ${x.n} shots<br>mean ${x.mu.toFixed(m.dec)}${m.unit} ± ${(1.96*x.se).toFixed(m.dec)}<br>trailing avg ${t.toFixed(m.dec)}<br>${sig?(better?'better, beyond noise':'worse, beyond noise'):'within noise'}`)}"/>`;
  });
  return {svg:s+'</svg>', nSig, n:sess.length};
}

/* ================= sparkline ================= */
function sparkHTML(club,mk,w=112,h=26){
  const m=METRICS[mk], sess=sessionsOf(club,3);
  if(sess.length<2)return '';
  const pts0=sess.map(ss=>quant(vals(ss.rows,m),.5));
  const lo=Math.min(...pts0),hi=Math.max(...pts0);
  const pts=pts0.map((v,i)=>[4+i/(pts0.length-1)*(w-8), h-3-((v-lo)/((hi-lo)||1))*(h-8)]);
  return `<svg viewBox="0 0 ${w} ${h}" style="width:${w}px" aria-hidden="true">
    <polyline points="${pts.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ')}" fill="none"
      stroke="${CLUB_COLOR[club]}" stroke-width="1.6" stroke-linejoin="round" stroke-opacity=".75"/>
    <circle cx="${pts[pts.length-1][0].toFixed(1)}" cy="${pts[pts.length-1][1].toFixed(1)}" r="2.6"
      fill="${CLUB_COLOR[club]}" stroke="var(--surface)" stroke-width="1.5"/></svg>`;
}
function metricCell(club,mk){
  const m=METRICS[mk], sess=sessionsOf(club,3);
  if(sess.length<2)return '';
  const cur=blockStat(sess.slice(-1),m), base=blockStat(sess.slice(-4,-1),m);
  const delta=cur.mu-base.mu, sig=diffSig(cur,base), imp=improve(m,cur.mu,base.mu);
  const cls=!sig?'flat':imp>0?'up':'dn';
  const arrow=delta>0?'▲':delta<0?'▼':'–';
  return `<a class="met" href="#/club/${esc(club)}/${esc(mk)}">
    <span class="k">${esc(m.short)}</span>
    <span class="v">${fmtV(m,cur.mu)}<em>${esc(m.unit.trim())}</em></span>
    <span class="chip ${cls}">${arrow} ${Math.abs(delta).toFixed(m.dec===3?2:1)}${sig?'':' · noise'}</span>
    ${sparkHTML(club,mk)}</a>`;
}

