    <p class="lede">Every session and club, newest first — the summary table the charts are computed from.</p>
    <div class="meta"><span><b>${recs.length}</b> session/club rows</span>
      <span><b>${ROWS.length.toLocaleString()}</b> shots</span></div>
  </div>

  <section class="block">
    <div class="blockhead"><h2>Per club</h2><span class="sub">Whole history, all sessions pooled.</span></div>
    <div class="panel"><div class="tablewrap"><table>
      <thead><tr><th>Club</th><th>Shots</th><th>Sessions</th><th>Total</th><th>σ</th><th>Carry</th>
        <th>Side</th><th>|Side|</th><th>Smash</th><th>F2P</th><th>Path</th></tr></thead>
      <tbody>${CLUB_LIST.slice().sort(byLoft).map(club=>{
        const r=clubRows(club), q=mk=>quant(vals(r,METRICS[mk]),.5);
        return `<tr><td><span class="clubtag"><i style="background:${CLUB_COLOR[club]}"></i>
          <a href="#/club/${esc(club)}">${esc(club)}</a></span></td>
          <td>${r.length.toLocaleString()}</td><td>${sessionsOf(club,1).length}</td>
          <td>${q('total').toFixed(0)}</td><td>${sd(vals(r,METRICS.total)).toFixed(1)}</td>
          <td>${q('carry').toFixed(0)}</td><td>${sgn(q('side'),0)}</td><td>${q('aside').toFixed(0)}</td>
          <td>${q('smash').toFixed(2)}</td><td>${sgn(q('f2p'),1)}</td><td>${sgn(q('path'),1)}</td></tr>`;
      }).join('')}</tbody></table></div></div>
  </section>

  <section class="block">
    <div class="blockhead"><h2>Per session</h2><span class="sub">Medians within each session.</span></div>
    <div class="panel"><div class="tablewrap"><table>
      <thead><tr><th>Date</th><th>Club</th><th>Shots</th><th>Total</th><th>σ</th><th>Carry</th>
        <th>Side</th><th>|Side|</th><th>Smash</th><th>F2P</th><th>Path</th></tr></thead>
      <tbody>${recs.map(rec=>{
        const q=mk=>quant(vals(rec.rows,METRICS[mk]),.5);
        return `<tr><td>${esc(fmtDY(rec.date))}</td>
          <td><span class="clubtag"><i style="background:${CLUB_COLOR[rec.club]}"></i>
            <a href="#/club/${esc(rec.club)}">${esc(rec.club)}</a></span></td>
          <td>${rec.rows.length}</td>
          <td>${q('total').toFixed(0)}</td><td>${sd(vals(rec.rows,METRICS.total)).toFixed(1)}</td>
          <td>${q('carry').toFixed(0)}</td><td>${sgn(q('side'),0)}</td><td>${q('aside').toFixed(0)}</td>
          <td>${q('smash').toFixed(2)}</td><td>${sgn(q('f2p'),1)}</td><td>${sgn(q('path'),1)}</td></tr>`;
      }).join('')}</tbody></table></div>
      <p class="caption">Distances and side in yards (+ right), angles in degrees. TrackMan reports these in metres
      and m/s regardless of display settings; everything here is converted to real-world units before it's stored.</p></div>
  </section>
  `;
  bindTips(app);
}

/* ================= router ================= */
let lastClub;
function render(){
  if(!ROWS.length){
    app.innerHTML=`<div class="viewhead"><h1>No shots yet.</h1>
      <p class="lede">Add a session from the dashboard and this page fills in automatically.</p></div>
      <p><a class="btn primary" href="<%= trackman_sessions_path %>">Add a session →</a></p>`;
    return;
  }
  const raw=(location.hash||'#/').replace(/^#/,'');
  const p=raw.split('/').filter(Boolean).map(decodeURIComponent);
  const view=p[0]||'';
  /* legacy #/trend/<club>/<metric> links now resolve inside the club page */
  if(view==='trend'){
    location.replace('#/club/'+encodeURIComponent(p[1]||CLUB_LIST[0])+'/'+encodeURIComponent(p[2]||'total'));
    return;
  }
  const club=view==='club'?(p[1]||''):'';
  const metric=(view==='club'&&METRICS[p[2]])?p[2]:'';
  document.querySelectorAll('#nav > a').forEach(a=>{
    const t=a.getAttribute('href').replace(/^#\//,'');
    a.removeAttribute('aria-current');
    if((!view&&!t)||(view&&t&&view===t))a.setAttribute('aria-current','page');
  });
  clubMenu.dataset.active=String(view==='club');
  clubDrop.querySelectorAll('a').forEach(a=>{
    const c=a.dataset.club;
    /* keep the measure you were reading when you switch club */
    a.setAttribute('href','#/club/'+encodeURIComponent(c)+(metric?'/'+metric:''));
    if(c===club)a.setAttribute('aria-current','page'); else a.removeAttribute('aria-current');
  });
  closeMenu();
  if(view==='club')viewClub(club,metric||'total');
  else if(view==='data')viewData();
  else viewOverview();
  /* only hold scroll position for a metric change within the SAME club (the
     trend selector); switching to a different club always jumps to top */
  const anchor=(metric&&club===lastClub)?document.getElementById('trend'):null;
  if(anchor)anchor.scrollIntoView({block:'start'});
  else window.scrollTo({top:0});
  lastClub=club;
}

/* --- clubs dropdown: hover on a mouse, tap on touch, keyboard-reachable either way --- */
const clubMenu=document.getElementById('clubmenu');
const clubBtn=document.getElementById('clubbtn');
const clubDrop=document.getElementById('clubdrop');
let pinned=false, closeT=null;
function openMenu(){clearTimeout(closeT);clubMenu.dataset.open='true';clubBtn.setAttribute('aria-expanded','true');}
function closeMenu(){clearTimeout(closeT);pinned=false;clubMenu.dataset.open='false';clubBtn.setAttribute('aria-expanded','false');}
function scheduleClose(){clearTimeout(closeT);closeT=setTimeout(()=>{if(!pinned)closeMenu();},280);}
clubDrop.innerHTML=CLUB_LIST.slice().sort(byLoft).map(c=>{
  const n=clubRows(c).length, s=sessionsOf(c,1).length;
  return `<a role="menuitem" data-club="${esc(c)}" href="#/club/${esc(c)}">
    <i style="background:${CLUB_COLOR[c]}"></i>${esc(c)}
    <span class="n">${n.toLocaleString()} shots · ${s}×</span></a>`;}).join('');
clubMenu.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')openMenu();});
clubMenu.addEventListener('pointermove',e=>{if(e.pointerType==='mouse')clearTimeout(closeT);});
clubMenu.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'&&!pinned)scheduleClose();});
clubBtn.addEventListener('click',()=>{pinned=!pinned;pinned?openMenu():closeMenu();});
clubMenu.addEventListener('focusin',openMenu);
clubMenu.addEventListener('focusout',()=>{
  setTimeout(()=>{if(!pinned&&!clubMenu.contains(document.activeElement))closeMenu();},0);});
clubDrop.addEventListener('click',closeMenu);
document.addEventListener('click',e=>{if(!clubMenu.contains(e.target))closeMenu();});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&clubMenu.dataset.open==='true'){closeMenu();clubBtn.focus();}});

window.addEventListener('hashchange',render);
render();
</script>

</body></html>