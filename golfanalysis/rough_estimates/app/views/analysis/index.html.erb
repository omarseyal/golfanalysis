  (i?'<span class="sep">/</span>':'')+(p[1]?`<a href="${esc(p[1])}">${esc(p[0])}</a>`:`<span>${esc(p[0])}</span>`)
).join('')+`</nav>`;

/* ---------- A. overview ---------- */
