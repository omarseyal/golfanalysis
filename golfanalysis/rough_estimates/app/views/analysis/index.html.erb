  wireSeg(app,'gapM',v=>{gapMetric=v;render();});
  wireSeg(app,'gapW',v=>{gapWindow=v;render();});
  bindTips(app);
}

/* ---------- B. club drill-down ---------- */
function viewClub(club,tmkRaw){
  if(!CLUB_LIST.includes(club))return viewMissing(club);
  const tmk=METRICS[tmkRaw]?tmkRaw:'total', tm=METRICS[tmk];
  const href=mk=>`#/club/${encodeURIComponent(club)}/${mk}`;
  const sess=sessionsOf(club,3), rows=clubRows(club), last=sess[sess.length-1];
  const stat=mk=>{
    const m=METRICS[mk];
    const cur=blockStat(sess.slice(-1),m), base=blockStat(sess.slice(-4,-1),m);
    let chip='';
    if(base.n){
      const delta=cur.mu-base.mu, sig=diffSig(cur,base), imp=improve(m,cur.mu,base.mu);
      const cls=!sig?'flat':imp>0?'up':'dn';
      chip=`<span class="chip ${cls}">${delta>0?'▲':delta<0?'▼':'–'} ${Math.abs(delta).toFixed(m.dec===3?2:1)}${sig?'':' · noise'}</span>`;
    }
    return `<a class="stat" href="${href(mk)}">
      <span class="k">${esc(m.short)} · last session</span>
      <span class="v">${fmtV(m,cur.mu)}<em>${esc(m.unit.trim())}</em></span>${chip}</a>`;};
  const mult=multiplesHTML(club);
  const roll=rollingSVG(club,tmk,rollWin), noise=noiseSVG(club,tmk), tst=story(club,tmk);

  app.innerHTML=`
  ${crumbs([['Overview','#/'],[club,null]])}
  <div class="viewhead">
    <div class="hero"><div class="title">
      <span class="bar" style="background:${CLUB_COLOR[club]}"></span>
      <h1>${esc(club)}</h1></div></div>
    <div class="meta">
      <span><b>${rows.length.toLocaleString()}</b> shots</span>
      <span><b>${sess.length}</b> sessions</span>
      <span><b>${esc(fmtDY(sess[0].date))}</b> → <b>${esc(fmtDY(last.date))}</b></span>
      <span>last session <b>${last.rows.length}</b> shots</span>
    </div>
    <div class="stats">${['carry','total','aside','smash','path','f2p'].map(stat).join('')}</div>
    <p class="statsnote">Last session against the three before it · grey means the move is inside noise · click any tile for its trend</p>
  </div>

  ${STORY_KEYS.map(mk=>{
    const m=METRICS[mk], r=ridgeSVG(club,mk), st=story(club,mk);
    if(!r)return '';
    return `<section class="block">
      <div class="blockhead">
        <h2>${esc(m.head)}</h2>
        <span class="sub">${esc(m.blurb)}</span>
        <a class="btn act" href="${href(mk)}">Trend &amp; confidence ↓</a>
      </div>
      <div class="panel">
        ${st?`<div class="story ${st.tone}"><span class="flagbar"></span><p>${st.txt}</p></div>`:''}
        <div class="plot">${r.svg}</div>
        <p class="caption">One ridge per session, newest at the bottom, each normalised to its own peak so a
        78-shot session doesn't dwarf a 12-shot one. Tick = median. Sessions under 8 shots draw as dots rather than
        a density — too little to claim a shape.</p>
      </div>
    </section>`;}).join('')}

  <section class="block anchored" id="trend">
    <div class="blockhead"><h2>Trend &amp; confidence</h2>
      <span class="sub">How fast ${esc(club)} is moving on one measure — and whether the move is real.</span></div>
    <div class="panel">
      <div class="controls">
        <div class="ctl"><span>Measure</span>${segHTML('tMetric',TREND_KEYS.map(k=>[k,METRICS[k].short]),tmk)}</div>
        <div class="ctl"><span>Window</span>${segHTML('tWin',[['25','25 shots'],['50','50'],['100','100']],String(rollWin))}</div>
      </div>
      ${tst?`<div class="story ${tst.tone}"><span class="flagbar"></span><p>${tst.txt}</p></div>`:''}

      <div class="subhead"><h3>Moving average &amp; rate of change</h3>
        <span>Every shot on a true date axis, smoothed — and how fast that smoothing is moving.</span></div>
      ${roll?`<div class="plot">${roll.svg}</div>
      <p class="caption">${roll.n.toLocaleString()} shots, centred ${roll.w}-shot window. Early slope averaged
      <b>${sgn(roll.early,roll.sdec)}${esc(tm.unit)}/month</b>; the most recent quarter of the record averages
      <b>${sgn(roll.recent,roll.sdec)}${esc(tm.unit)}/month</b>. The line stops ${Math.floor(roll.w/2)} shots short of
      each end because a centred window has nothing to centre on out there. Sessions sit at their real dates, so a
      six-week gap looks like a six-week gap.</p>`
      :`<p class="empty">Not enough shots for a ${rollWin}-shot window.</p>`}

      <div class="divide"></div>
      <div class="subhead"><h3>Is it real?</h3>
        <span>Session means with 95% intervals, against a five-session trailing average.</span></div>
      ${noise?`<div class="plot">${noise.svg}</div>
      <div class="legend">
